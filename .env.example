NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://unimate:unimate@localhost:5432/unimate
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Provider options:
# mock   — Offline demo mode; no API key or cost, but does not generate real AI tutor answers.
# openai — Billing/API credits normally required; suitable for reliable personal or classroom use when provisioned with adequate limits.
# groq   — Free tier is useful for development/personal testing but its token limits are too low for this document-heavy classroom workflow; Developer tier is suitable.
# gemini — Recommended current default; free quotas vary by Google project, while a paid tier is preferable for dependable classroom concurrency.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash
# Embeddings always use the local hash-based fallback for every provider.
EMBEDDING_MODEL=local-hash-v1
EMBEDDING_DIMENSIONS=1536
AI_API_KEY=
# Provider defaults are used when unset. Gemini defaults to:
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# AI_TEMPERATURE=0.2
AI_MAX_OUTPUT_TOKENS=4000
AI_TIMEOUT_MS=45000
AI_MAX_RETRIES=2
RAG_TOP_K=8
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./uploads
# Required when STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
MAX_FILE_SIZE_MB=25
MAX_SOURCES_PER_COURSE=50
WORKER_POLL_INTERVAL_MS=2000
VITE_API_URL=http://localhost:4000/api/v1
# Transactional email (Resend)
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
