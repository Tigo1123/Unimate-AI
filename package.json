{
  "name": "unimate-ai",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,green \"npm run dev -w @unimate/web\" \"npm run dev -w @unimate/api\"",
    "dev:with-worker": "concurrently -n web,api,worker -c cyan,green,magenta \"npm run dev -w @unimate/web\" \"npm run dev -w @unimate/api\" \"npm run dev -w @unimate/worker\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:generate": "npm run db:generate -w @unimate/api",
    "db:migrate": "npm run db:migrate -w @unimate/api",
    "db:seed": "npm run db:seed -w @unimate/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/express": "^4.17.25",
    "@types/express-serve-static-core": "^4.19.9",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.19.1"
  },
  "engines": {
    "node": ">=20"
  }
}
